---

---

<section
  id="hero"
  class="py-20 md:py-32 flex flex-col items-start border-b border-zinc-800"
>
  <div
    class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-zinc-800/50 border border-zinc-700 text-zinc-300 text-xs font-mono mb-8 uppercase tracking-wider"
  >
    <span class="relative flex h-1.5 w-1.5">
      <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-emerald-500"
      ></span>
    </span>
    Disponibile per stage curriculare
  </div>

  <h1
    class="text-4xl md:text-6xl font-semibold tracking-tight text-zinc-100 mb-6 font-sans"
  >
    Ingegnere Informatico in Formazione, <br class="hidden md:block" />
    <span class="text-zinc-400">
      appassionato di Dati e Analisi Funzionale .
    </span>
  </h1>

  <p class="text-lg md:text-xl text-zinc-400 max-w-2xl mb-10 leading-relaxed">
    Sono <strong>Matteo Algozzino</strong>, laureando in Ingegneria Informatica
    a Tor Vergata. Ho una forte base accademica in Basi di Dati, Analisi dei
    Requisiti e Sviluppo Software. Sono alla ricerca di uno <strong
      >stage curriculare</strong
    > per mettermi in gioco, imparare da un vero team e dare il mio contributo fin
    dal primo giorno.
  </p>

  <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
    <a
      href="#projects"
      class="inline-flex justify-center items-center gap-2 rounded-sm bg-zinc-100 text-zinc-900 px-6 py-3 font-medium hover:bg-zinc-200 transition-colors duration-150"
    >
      Esplora i Progetti
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M19 14l-7 7m0 0l-7-7m7 7V3"></path></svg
      >
    </a>
    <a
      href="https://www.linkedin.com/in/matteo-algozzino-6283b8431"
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex justify-center items-center gap-2 rounded-sm border border-zinc-700 bg-transparent px-6 py-3 font-mono text-sm text-zinc-300 hover:bg-zinc-800 transition-colors duration-150 uppercase tracking-wider"
    >
      [ LinkedIn ]
    </a>
    <a
      href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/cv-matteo-algozzino.pdf`}
      target="_blank"
      rel="noopener noreferrer"
      class="md:hidden inline-flex justify-center items-center gap-2 rounded-sm border border-zinc-700 bg-transparent px-6 py-3 font-mono text-sm text-zinc-300 hover:bg-zinc-800 transition-colors duration-150 uppercase tracking-wider"
    >
      [ SCARICA CV ]
    </a>
  </div>
</section>
