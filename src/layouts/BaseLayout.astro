---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Portfolio di Matteo Algozzino, Software & Data Engineering student." } = Astro.props;
---

<!doctype html>
<!-- Impostiamo la classe 'dark' di default -->
<html lang="it" class="scroll-smooth dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body class="antialiased min-h-screen flex flex-col bg-zinc-900 text-zinc-200">
    <!-- Navbar -->
    <header class="sticky top-0 z-50 w-full backdrop-blur-md bg-zinc-900/80 border-b border-zinc-800">
      <div class="container mx-auto px-4 h-16 flex items-center justify-between max-w-5xl">
        <a href="#" class="font-bold text-lg tracking-tight text-zinc-100">Matteo Algozzino<span class="text-emerald-500">.</span></a>
        
        <nav class="hidden md:flex items-center gap-6 text-sm font-medium text-zinc-400">
          <a href="#about" class="hover:text-emerald-500 transition-colors duration-150">Vision</a>
          <a href="#skills" class="hover:text-emerald-500 transition-colors duration-150">Competencies</a>
          <a href="#projects" class="hover:text-emerald-500 transition-colors duration-150">Case Studies</a>
          <a href="#timeline" class="hover:text-emerald-500 transition-colors duration-150">Timeline</a>
        </nav>

        <div class="flex items-center gap-4">
          <a href="/cv-matteo-algozzino.pdf" target="_blank" rel="noopener noreferrer" class="hidden md:inline-flex items-center justify-center rounded-sm border border-zinc-700 text-sm font-medium bg-transparent text-zinc-200 hover:bg-zinc-800 hover:border-zinc-600 h-9 px-4 py-2 transition-colors duration-150 font-mono">
            [DOWNLOAD CV]
          </a>
        </div>
      </div>
    </header>

    <main class="flex-grow container mx-auto px-4 max-w-5xl py-8 md:py-16">
      <slot />
    </main>

    <footer class="border-t border-zinc-800 bg-zinc-900 mt-16 py-8">
      <div class="container mx-auto px-4 max-w-5xl flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-zinc-500 text-sm font-mono">
          © {new Date().getFullYear()} Matteo Algozzino. All rights reserved.
        </p>
        <div class="flex items-center gap-6 text-zinc-500">
          <a href="https://github.com/algomass" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-500 transition-colors duration-150">
            <span class="sr-only">GitHub</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" /></svg>
          </a>
          <a href="https://www.linkedin.com/in/matteo-algozzino-6283b8431" target="_blank" rel="noopener noreferrer" class="hover:text-emerald-500 transition-colors duration-150">
            <span class="sr-only">LinkedIn</span>
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" clip-rule="evenodd" /></svg>
          </a>
          <a href="mailto:algozzinomatteo@gmail.com" class="hover:text-emerald-500 transition-colors duration-150">
            <span class="sr-only">Email</span>
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>
